<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly REVIEW job: refits HRP weights across strategies, aggregates
  the week's daily-run JSONs, emails a summary.

  CATCH-UP DESIGN (changed 2026-07-05)
  ------------------------------------
  This no longer fires once at Sat 06:30 and hope the Mac is awake+online
  at that instant. Two consecutive weeks were silently lost that way
  (2026-06-26: job never fired; 2026-07-03: fired but the Mac had no
  network). Instead it runs the IDEMPOTENT wrapper weekly-review-catchup.sh
  EVERY morning at 06:30. The wrapper:
    - sends only if THIS completed week's report isn't already saved, so
      six mornings out of seven it exits in milliseconds;
    - waits for DNS before running (fixes "woke but Wi-Fi not up yet");
    - therefore catches up on the first morning the Mac is awake+online
      after a Friday close — a Mac off all weekend still sends on Monday.

  06:30 CST maps to the previous late-afternoon ET (after the US close):
    18:30 prior-day EDT (summer) / 17:30 EST (winter). The wrapper itself
  computes the target Friday, so the fire day no longer has to align with
  a --for-date argument.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.terrancehan.quant-weekly-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>'/Users/terrancehan/Claude trader/quant/launchd/weekly-review-catchup.sh'</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/terrancehan/Claude trader/quant</string>

    <key>StandardOutPath</key>
    <string>/Users/terrancehan/Claude trader/quant/data/agent/launchd-logs/weekly-review.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/terrancehan/Claude trader/quant/data/agent/launchd-logs/weekly-review.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
